extends Node
## Autoload "Sfx": music + sound effects, with on/off settings saved per device.
## All audio files are generated by tools/make_audio.py (original, no samples).
##   Sfx.play("hit")                 one-shot sound
##   Sfx.play("dash", -8.0, 0.1)     quieter, with random pitch variation
##   Sfx.music("lobby")              switch music (crossfades), "" = stop

const SFX := [
	"click", "ready", "count", "go", "join", "dash", "hit", "fall", "launch", "lock", "shrink",
	"tick", "tick_hi", "explosion", "tag", "powerup", "freeze", "warp", "splat", "frenzy",
	"eraser", "ding", "out",
]
const MUSIC := {
	"lobby": "music_lobby", "bumper_sumo": "music_sumo", "bomb_tag": "music_bomb",
	"tile_painter": "music_paint", "fanfare": "fanfare",
}
const MUSIC_DB := -9.0
const VOICES := 10
const SETTINGS_PATH := "user://audio_settings.cfg"

var music_on := true
var sfx_on := true
var _streams: Dictionary = {}
var _voices: Array = []
var _next_voice := 0
var _last_played: Dictionary = {}     # name -> msec (stops the same sound spamming)
var _music_a: AudioStreamPlayer
var _music_b: AudioStreamPlayer
var _current_music := ""
var _music_tween: Tween

signal settings_changed


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	_load_settings()
	for i in VOICES:
		var p := AudioStreamPlayer.new()
		add_child(p)
		_voices.append(p)
	_music_a = AudioStreamPlayer.new()
	_music_b = AudioStreamPlayer.new()
	add_child(_music_a)
	add_child(_music_b)
	for n in SFX:
		_streams[n] = _load_stream("res://audio/sfx_%s.ogg" % n, false)
	for k in MUSIC:
		_streams["m_" + k] = _load_stream("res://audio/%s.ogg" % MUSIC[k], k != "fanfare")


## Loads an .ogg whether or not the editor has imported it yet.
func _load_stream(path: String, loop: bool) -> AudioStream:
	var s: AudioStream = null
	if ResourceLoader.exists(path):
		s = load(path) as AudioStream
	if s == null and FileAccess.file_exists(path):
		s = AudioStreamOggVorbis.load_from_file(path)
	if s is AudioStreamOggVorbis:
		(s as AudioStreamOggVorbis).loop = loop
	return s


func play(sound: String, volume_db: float = 0.0, pitch_var: float = 0.0, min_gap_ms: int = 40) -> void:
	if not sfx_on:
		return
	var st: AudioStream = _streams.get(sound)
	if st == null:
		return
	var now := Time.get_ticks_msec()
	if now - int(_last_played.get(sound, -100000)) < min_gap_ms:
		return
	_last_played[sound] = now
	var p: AudioStreamPlayer = _voices[_next_voice]
	_next_voice = (_next_voice + 1) % VOICES
	p.stream = st
	p.volume_db = volume_db
	p.pitch_scale = 1.0 + randf_range(-pitch_var, pitch_var) if pitch_var > 0.0 else 1.0
	p.play()


func music(key: String) -> void:
	if key == _current_music:
		return
	_current_music = key
	if _music_tween != null and _music_tween.is_valid():
		_music_tween.kill()
	# Crossfade: old player fades out, new one fades in.
	var old := _music_a
	_music_a = _music_b
	_music_b = old
	_music_tween = create_tween().set_parallel(true)
	if _music_b.playing:
		_music_tween.tween_property(_music_b, "volume_db", -40.0, 0.6)
		_music_tween.chain().tween_callback(_music_b.stop)
	if key == "" or not music_on:
		return
	var st: AudioStream = _streams.get("m_" + key)
	if st == null:
		return
	_music_a.stream = st
	_music_a.volume_db = -40.0
	_music_a.play()
	_music_tween.tween_property(_music_a, "volume_db", MUSIC_DB, 0.6)


## Fanfare once, then go back to a looping track.
func fanfare_then(next_key: String) -> void:
	music("fanfare")
	var st: AudioStream = _streams.get("m_fanfare")
	var dur: float = st.get_length() if st != null else 0.0
	get_tree().create_timer(maxf(dur - 0.3, 0.5)).timeout.connect(func():
		if _current_music == "fanfare":
			music(next_key))


func set_music_on(on: bool) -> void:
	music_on = on
	var key := _current_music
	_current_music = ""
	if on:
		music(key)
	else:
		_music_a.stop()
		_music_b.stop()
		_current_music = key
	_save_settings()
	settings_changed.emit()


func set_sfx_on(on: bool) -> void:
	sfx_on = on
	_save_settings()
	settings_changed.emit()


func _load_settings() -> void:
	var cf := ConfigFile.new()
	if cf.load(SETTINGS_PATH) == OK:
		music_on = bool(cf.get_value("audio", "music", true))
		sfx_on = bool(cf.get_value("audio", "sfx", true))


func _save_settings() -> void:
	var cf := ConfigFile.new()
	cf.set_value("audio", "music", music_on)
	cf.set_value("audio", "sfx", sfx_on)
	cf.save(SETTINGS_PATH)
